{
  "name": "update-workspace-root-version",
  "version": "1.0.4",
  "description": "Update the workspace root version in a monorepo",
  "keywords": [
    "codemod",
    "semver",
    "versioning",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/update-workspace-root-version.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": "dist/bin/update-workspace-root-version.js",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./build.sh --production",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "release:prepare": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "test": "./build.sh --test && mt dist-for-testing --quiet"
  },
  "dependencies": {
    "@codemod-utils/files": "^2.1.0",
    "@codemod-utils/json": "^1.1.14",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@changesets/get-github-info": "^0.6.0",
    "@codemod-utils/tests": "^1.1.11",
    "@ijlee2-frontend-configs/eslint-config-node": "^0.2.3",
    "@ijlee2-frontend-configs/prettier": "^0.2.1",
    "@ijlee2-frontend-configs/typescript": "^0.3.1",
    "@sondr3/minitest": "^0.1.2",
    "@types/node": "^18.19.76",
    "@types/yargs": "^17.0.33",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": "18.* || >= 20"
  },
  "pnpm": {
    "overrides": {
      "get-tsconfig": "4.7.3"
    }
  }
}
